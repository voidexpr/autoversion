ARCHIVE_HOME=${ARCHIVE_HOME:=$HOME/fswarchive}
VERBOSE=0

function abort {
    echo "ERROR: $*"
    kill -INT $$
}

function warn {
    echo "WARNING: $*"
}

function myrealpath {
    if which grealpath >>/dev/null 2>&1; then
        grealpath "$1"
    else
        realpath "$1"
    fi
}

function relative-path {
    BASE="$1"
    APATH="$2"
    echo ${APATH#$BASE/} | perl -lane 's/([\.\/]+)$//g;s/\/\//\//g;print;'
}

function strip-home {
    relative-path "$HOME" "$1"
}

function archive-path {
    SOURCE=$(myrealpath "$1")
    REL_SOURCE=$(strip-home "$SOURCE")
    [ "$REL_SOURCE" = "" ] && abort "bad source file/dir $1 ($SOURCE)"
    echo "$ARCHIVE_HOME/$REL_SOURCE"
}

# TODO: make smarter by skipping files that are in a git repo
#       this way don't cluter the archive with code that is not really changed
function archive-find {
    BASE=$(myrealpath "$1")
    ARCHIVE=$(archive-path "$BASE")
    FILES_FROM="/tmp/$$.files"
    [ -f "$FILES_FROM" ] && rm "$FILES_FROM"
    pushd "$BASE" &&
        find . | ignore-filter | while read file; do
            echo "$file" >> "$FILES_FROM"
        done
    popd
    echo "rsync $(wc -l $FILES_FROM) files"
    rsync -avi --files-from="$FILES_FROM" "$BASE" "$ARCHIVE"
    rm "$FILES_FROM"
    pushd "$ARCHIVE" &&
        git add .
        git commit -a -m "backup from find"
    popd
}

function is-git-repo {
    if [ -d "$1" ]; then
        pushd "$1" > /dev/null
        git rev-parse --show-toplevel 2>1 1> /dev/null
        RES=$?
        popd > /dev/null
    else
        RES=2
    fi
    return $RES
}

function archive-init-if-needed {
    ARCHIVE=$(archive-path "$1")
    is-git-repo "$ARCHIVE" || archive-init "$1"
}

function archive-init {
    ARCHIVE_DIR=$(archive-path "$1")
    echo "Init archive: $ARCHIVE_DIR"
    [ -d "$ARCHIVE_DIR" ] || mkdir -p "$ARCHIVE_DIR"
    if [ ! -d "$ARCHIVE_DIR/.git" ]; then
        is-git-repo "$ARCHIVE_DIR" && abort "trying to track path that is already tracked"
        echo "make $ARCHIVE_DIR a git repo"
        pushd "$ARCHIVE_DIR" &&
            git init . || abort "failed to git init"
        popd
    fi
}

function git-async-commit {
    FILE="$1"
    ARCHIVE="$2"
    SLEEP=${3:-2}
    pushd "$ARCHIVE" || abort "no archive"
        git add $(dirname "$FILE") || abort "failed to git add"
        STATE="/tmp/.$$.archive_commit"
        if [ ! -e $STATE ]; then
            touch "$STATE"
            (sleep $SLEEP ; git commit -m "backup" ; rm "$STATE") &
        else
            echo "commit already pending (state file: $STATE)"
            touch $STATE
        fi
    popd
}

function ignore-filter-by-name {
    perl -lane '
        print unless (
                /\.(log|dump|swp|swpx|swo|pid|lock|beam|bea#)$/
            ||  /\/\d+$/  # vim/fs temp files
            || /[~]$/
            || /^(\.|\.\.)$/
            || /\.(out|stdout|err|stderr|depend|dropbox)/
            || /\.(log|old|temp)$/
            || /.(DS_Store|nfs)$/
            || /\.(o|so|a|sym)$/
            || /\.(git|hg|svn|cvs)\//
            || /\.(venv|pytest_cache|playwright-mcp)/
            || /node_modules\//
            || /__pycache__/
            || /\.(pyc|wal)$/
            || -d
            # || ( (-s $_) > (10*1024*1024))
        );
    '
}

function ignore-filter {
    ignore-filter-by-name | while read file; do
        is-file-big $BIG_FILE_100MB "$file" || echo "$file"
    done
    # for arg in "$@"; do
    #     [ -z "$(ignore-file "$arg")" ] || echo "$arg"
    #     # ignore-filter-by-name "$arg" | while read file; do
    #     #     is-file-big $BIG_FILE_100MB "$file" || echo "$file"
    #     # done
    # done
}

function is-file-big {
    local max_bytes="$1"
    local file="$2"
    local size

    # get file size (cross-platform: Linux/macOS)
    size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null)

    if (( size > max_bytes )); then
        printf 'warning: skip "%s" exceeds limit (%d > %d)\n' "$file" "$size" "$max_bytes" >&2
        return 0  # true → file is big
    else
        return 1  # false → file is not big
    fi
}

# BIG_FILE_100MB=1
# BIG_FILE_100MB=10485760
BIG_FILE_100MB=$((10 * 1024 * 1024))

function ignore-file {
    MATCH=$(echo "$*" | ignore-filter)
    if [ -z "$MATCH" ]; then
        return 0
    else
        if is-file-big $BIG_FILE_100MB "$MATCH"; then
            return 0
        else
            return 1
        fi
    # else
    #     return 1
    fi
    # [ -z "$MATCH" ]
}

function archive-copy {
    #echo "archive-copy \"$1\" \"$2/$(dirname \"$1\")"
    destdir="$2/$(dirname "$1")"
    [ -f "$destdir" ] && unlink "$destdir"
    #[ -d "$destdir" ] || mkdir -p "$destdir"
    rsync -a "$1" "$destdir/" || echo "failed to copy"
    #rsync -a "$1" "$2/$(dirname "$1")" || echo "failed to copy"
}

function archive-save {
    FILE="$1"
    ARCHIVE="$2"
    ignore-file "$FILE" || archive-copy "$FILE" "$ARCHIVE"
}

function show_help {
   cat << EOF
Usage: ${0##*/} [-h] ACTION DIR [FILE]

    -h          display this help and exit
    -b|base DIR what to consider as the root directory to copy to

    watch  DIR
    save   -b BASE_DIR FILE
    init   DIR
    find   DIR
    commit DIR
    filter DIR [-out FILE]

Copy modified files to a separate archive directory which is under
git control as a way to maintain near real-time (2 seconds)
versioning of files as they are edited, git changes branches, etc ...

Automatically initialize the archive directory.

By default git commits are done with 2 seconds delay to accomodate
when a large number of files are changed (for example when doing git
fetch at the source)

Uses fswatch (mac) or inotifywait (linux) to avoid scanning

EOF
}

ACTION=""
BASE=
OTHER=()

while :; do
    case $1 in
        -h|-\?|--help|help)
            show_help
            exit
            ;;
        -v|-verbose|--verbose)
            VERBOSE=$((VERBOSE+1))
            ;;
        watch|save|init|find|commit|filter)
            ACTION=$1
            ;;
        -b|--base)
            [ -z "$2" ] && abort "--base requires a non-empty option argument"
            BASE="$2"
            shift
            ;;
        --)
            shift
            break
            ;;
        -?*)
            abort "Unknown option: $1"
            exit 1
            ;;
        *)
            break
    esac
    shift
done

if [ $VERBOSE -gt 0 ]; then
    echo "VERBOSE: opts: ACTION=$ACTION VERBOSE=$VERBOSE BASE=$BASE, left: $*"
fi

if [ -z "$BASE" ]; then
    BASE="$1"
    shift
fi
FILE="$1"

BASE=$(myrealpath "$BASE")
[ -n "$BASE" ] || abort "missing base dir (-b DIR)"
[ -d "$BASE" ] || abort "base not a dir: $BASE"

ARCHIVE=$(archive-path "$BASE")
echo "action=$ACTION base=$BASE file=$FILE archive=$ARCHIVE"

function fswatch-linux {
    # on Linux (ubuntu/pops) fswatch is way chattier than on MacOS, even read
    # events are returned by default
    # but even with event filtering a single file update results into
    # multiple events to be emitted regardless of the -l TIMEOUT value
    /usr/bin/fswatch --event Updated --event Created --event Removed
}


function myfswatch {
    DIR="$1"
    FSWATCH=${FSWATCH:=/opt/homebrew/bin/fswatch} # OLD: /usr/local/bin/fswatch}
    TIMEOUT=1
    if `which inotifywait > /dev/null`; then
        myinotifywait "$DIR" $TIMEOUT
    elif `which $FSWATCH > /dev/null`; then
        $FSWATCH -l $TIMEOUT -L -r  --extended --exclude ".git/" --exclude "/1$" .
    elif `which /usr/bin/fswatch > /dev/null`; then
        fswatch-linux -l $TIMEOUT -L -r  --extended --exclude ".git/" --exclude "/1$" .
    else
        abort "no inotifywait/fswatch"
    fi
}

case $ACTION in
    watch)
        archive-init-if-needed "$BASE" && archive-find "$BASE"
        pushd "$BASE" &&
            echo "watching changes in \"$BASE\""
            myfswatch "$BASE" | while read file; do
                echo "[$(date '+%m/%d %H:%M')] detected change: $file"
                if ignore-file "$file"; then
                    echo "    ignore: $file"
                elif [ -f "$file" ]; then
                    file=$(myrealpath "$file")
                    file=$(relative-path "$BASE" "$file")
                    archive-copy "$file" "$ARCHIVE"
                    git-async-commit "$file" "$ARCHIVE"
                elif [ ! -f "$file" ]; then
                    file=$(myrealpath "$file")
                    file=$(relative-path "$BASE" "$file")
                    echo "detected deleted: \"$file\". delete $ARCHIVE/$file"
                    rm "$ARCHIVE/$file"
                    git-async-commit "$file" "$ARCHIVE"
                fi
            done
            wait
        popd
        ;;
    filter)
        pushd "$BASE"
            find . | ignore-filter | while read file; do
                echo "$file"
            done
            # find . | ignore-filter | while read file; do
            #     if ignore-file "$file"; then
            #         echo "exclude: $file"
            #     else
            #         echo "include: $file"
            #     fi
            # done
        popd
        ;;
    find)
        archive-init-if-needed "$BASE" && archive-find "$BASE"
        ;;
    init)
        archive-init "$BASE" && archive-find "$BASE"
        ;;
    commit)
        pushd $(archive-path "$BASE") &&
            git commit -a -m "forced commit"
        popd
        ;;
    save)
        [ -n "$FILE" ] || abort "missing file"
        archive-init-if-needed "$BASE" && archive-find "$BASE"
        FILE=$(myrealpath "$FILE")
        REL_FILE=$(relative-path "$BASE" "$FILE")
        archive-save "$ARCHIVE" "$REL_FILE"
        pushd "$ARCHIVE" || abort "no archive"
            git-async-commit "$REL_FILE" "$ARCHIVE" 0
        popd
        ;;
    help)
        show-help
        ;;
    *)
        abort "unknown action: $ACTION"
esac


