  "sugar": [
    {"kind": "include", "rule": "/a/!b", "expanded": ["include /a", "exclude /a/b"]},
    {"kind": "include", "rule": "/!{Pictures,Movies}", "expanded": ["exclude /Pictures", "exclude /Movies"]},
    {"kind": "include", "rule": "/Dropbox/!{Borg,Articles}", "expanded": ["include /Dropbox", "exclude /Dropbox/Borg", "exclude /Dropbox/Articles"]},
    {"kind": "exclude", "rule": "/Library/Containers/!net.whatsapp.WhatsApp", "expanded": ["exclude /Library/Containers/*", "include /Library/Containers/net.whatsapp.WhatsApp"]},
    {"kind": "exclude", "rule": "/!{Sync,Travel/Older Trips/x}", "expanded": ["exclude /*", "include /Sync", "include /Travel/Older Trips/x"]},
    {"kind": "exclude", "rule": "/{a,b}/{c,d}", "expanded": ["exclude /a/c", "exclude /a/d", "exclude /b/c", "exclude /b/d"]},
    {"kind": "exclude", "rule": "f:/**/{*.old,*.bak}", "expanded": ["exclude f:/**/*.old", "exclude f:/**/*.bak"]},
    {"kind": "include", "rule": "/{one}", "expanded": ["include /one"]},
    {"kind": "exclude", "rule": "d:/**/build", "expanded": ["exclude d:/**/build"]}
